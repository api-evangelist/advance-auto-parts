{
  "opencollection": "1.0.0",
  "info": {
    "name": "Advance Auto Parts Catalog Cart Stores API",
    "version": "1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-Key",
      "value": "{{X-API-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Stores",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Advance Auto Parts List Nearby Stores",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.advanceautoparts.com/v1/stores",
            "params": [
              {
                "name": "zip",
                "value": "",
                "type": "query",
                "description": "ZIP code to search near."
              },
              {
                "name": "lat",
                "value": "",
                "type": "query",
                "description": "Latitude coordinate."
              },
              {
                "name": "lon",
                "value": "",
                "type": "query",
                "description": "Longitude coordinate."
              },
              {
                "name": "radius",
                "value": "",
                "type": "query",
                "description": "Search radius in miles."
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum number of stores to return."
              }
            ]
          },
          "docs": "Find Advance Auto Parts store locations near a ZIP code or geographic coordinates."
        }
      ]
    }
  ],
  "bundled": true
}